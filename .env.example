# Vorlage für lokale .env — kopieren nach `.env` (ist gitignored).

# Farb-Panel für die Abstimmung mit Julia.
# "true"  = Panel wird gerendert (Design-Phase)
# alles andere / nicht gesetzt = Panel rendert nichts (Go-Live)
#
# ⚠️ Auch in den Vercel-Environment-Variablen setzen, sonst ist das Panel
#    im Deployment weg. Zum Go-Live dort auf false setzen bzw. entfernen.
VITE_THEME_PANEL=true

# Google-Tag-Manager-Container. Leer lassen = GTM wird nie geladen.
# Der Loader ist consent-gated: das Script lädt erst, wenn die Nutzerin
# Statistik oder Marketing zugestimmt hat (src/lib/consent.js).
VITE_GTM_ID=
